# Gold & Silver Agent System - Environment Variables
# Copy this file to .env and fill in your actual API keys
# 
# Quick setup:
#   cp env.sample .env
#   nano .env  # or use your preferred editor

# ============================================
# FRED API Key (Required for full functionality)
# ============================================
# Get your free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
# 1. Register at https://fred.stlouisfed.org/
# 2. Go to "My Account" → "API Keys"
# 3. Create a new API key
# 4. Paste it below (replace 'your_fred_api_key_here')
FRED_API_KEY=your_fred_api_key_here

# ============================================
# OpenAI API Key (Optional - for LLM explanations)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# Note: The system will work without this key, but will use template-based explanations
# instead of LLM-generated ones. LLM explanations are more detailed and contextual.
# 1. Sign up at https://platform.openai.com/
# 2. Go to "API Keys"
# 3. Create a new secret key
# 4. Paste it below (replace 'your_openai_api_key_here')
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Optional: Custom Configuration
# ============================================
# You can override default settings here if needed
# (Most users don't need to modify these - uncomment to use)

# Prediction horizons (days)
# PREDICTION_SHORT_TERM=7
# PREDICTION_MEDIUM_TERM=30
# PREDICTION_LONG_TERM=90

# Agent weights (0.0 to 1.0, should sum to 1.0)
# MACRO_WEIGHT=0.25
# MARKET_WEIGHT=0.20
# TECHNICAL_WEIGHT=0.15
# FUNDAMENTAL_WEIGHT=0.20
# CORRELATION_WEIGHT=0.20



